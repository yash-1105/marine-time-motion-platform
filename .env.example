DATABASE_URL=postgresql://admin:password@localhost:5434/marine_platform
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
UPLOAD_MAX_BYTES=26214400
# Local development path; production mounts the governed GCS/MinIO adapter here.
INGESTION_STORAGE_PATH=/tmp/marine-platform-uploads

OIDC_CLIENT_ID=marine-platform-client
OIDC_CLIENT_SECRET=change-me
OIDC_ISSUER_URL=https://login.microsoftonline.com/common/v2.0

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Backend only: never prefix these with NEXT_PUBLIC_.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
REPORT_STORAGE_PATH=/tmp/marine-platform-reports
